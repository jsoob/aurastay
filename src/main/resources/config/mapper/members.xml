<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.co.aura.aurastay.repository.MemberRepository">
    <insert id="insertMember" parameterType="MemberDTO">
        insert into member
        values(null,#{memberEmail},#{providerId},#{memberPassword},#{memberName},#{memberNickname},#{memberPhoneNumber},0,current_timestamp(),null,#{authority})
    </insert>
    <!--  -->
    <select id="findByUsername" parameterType="String" resultType="MemberDTO">
        select *
        from member
        where member_email = #{username}
    </select>
</mapper>