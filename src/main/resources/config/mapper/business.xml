<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.co.aura.aurastay.repository.BusinessRepository">
    <insert id="insertBusiness" parameterType="BusinessDTO">
        insert into business
        values(#{businessNo},#{businessName},#{representativeName},#{businessEmail},#{businessPhoneNumber},#{businessPassword},#{businessAccount},current_timestamp,null,#{authority})
    </insert>
    <select id="findByUsername" parameterType="String" resultType="BusinessDTO">
        select *
        from business
        where business_email = #{username}
    </select>
</mapper>