<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.co.aura.aurastay.repository.ReservationRepository">

    <select id="existsByAccommodationNo" parameterType="int" resultType="boolean">
        SELECT COUNT(*) > 0 FROM reservation WHERE accommodation_no = #{acmNo}
    </select>

